NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only API key for importing cards (at least 32 random characters).
AGENT_API_KEY=
# Supabase Authentication → Users → your account's User UID.
AGENT_USER_ID=

# ChatGPT plugin / remote MCP (enable after setting the public URL).
MCP_ENABLED=false
# Origin only, no trailing slash, e.g. https://anki.ask-t.org
APP_BASE_URL=
# Preconfigured OAuth client ID and secret (server-only).
MCP_CLIENT_ID=
# Generate with: openssl rand -hex 32
MCP_CLIENT_SECRET=
# Exact callback shown in ChatGPT. Default supports issuer identification.
MCP_REDIRECT_URI=https://chatgpt.com/connector_platform_oauth_redirect
