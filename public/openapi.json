{
  "openapi": "3.1.0",
  "info": {
    "title": "Anki App vocabulary import",
    "version": "1.0.0",
    "description": "Add or update vocabulary for one configured owner. Review history is preserved. Maximum request size: 512 KiB."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/cards/import": {
      "post": {
        "operationId": "importVocabularyCards",
        "summary": "Add or update vocabulary cards",
        "security": [
          {
            "AgentApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cards"
                ],
                "properties": {
                  "cards": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "external_id",
                        "word",
                        "japanese_meaning"
                      ],
                      "properties": {
                        "external_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                          "description": "Stable ID reused for updates and retries."
                        },
                        "word": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "japanese_meaning": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "explanation": {
                          "type": "string",
                          "maxLength": 4000,
                          "default": ""
                        },
                        "example": {
                          "type": "string",
                          "maxLength": 4000,
                          "default": ""
                        },
                        "part_of_speech": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 80
                        },
                        "source_url": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 2048,
                          "pattern": "^https?://",
                          "description": "HTTP(S) source URL or null."
                        }
                      }
                    }
                  },
                  "folder_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Folder name; provide together with set_name. Reuses a unique match or creates it."
                  },
                  "set_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Set name; provide together with folder_name. Reuses a unique match or creates it."
                  }
                },
                "dependentRequired": {
                  "folder_name": [
                    "set_name"
                  ],
                  "set_name": [
                    "folder_name"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All submitted cards were saved. Total includes inserts and updates.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "total",
                    "external_ids"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "total": {
                      "type": "integer"
                    },
                    "external_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "folder_name": {
                      "type": "string"
                    },
                    "set_name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or vocabulary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Request too large",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "JSON content type required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Database write failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Server not configured",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "More than one matching folder or set; import aborted."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AgentApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    }
  }
}
